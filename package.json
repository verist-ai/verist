{
  "name": "verist-monorepo",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/bun": "^1.3.8",
    "@types/pg": "^8.15.0",
    "verist": "workspace:*",
    "@verist/llm": "workspace:*",
    "@verist/storage": "workspace:*",
    "@verist/storage-pg": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "openai": "^6.17.0",
    "pg": "^8.16.0",
    "prettier": "^3.8.1",
    "srcpack": "^0.1.15",
    "typescript": "^5.9.3",
    "vitepress": "^2.0.0-alpha.15",
    "vitepress-plugin-llms": "^1.11.0",
    "vue": "^3.5.27",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "scripts": {
    "check": "tsc",
    "build": "bun run scripts/build.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "prepublish": "bun run scripts/prepublish.ts",
    "release": "bun run prepublish && changeset publish && git checkout packages/*/package.json",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "docs:deploy": "gh-pages -d .vitepress/dist -b main -o docs",
    "prepare": "husky"
  }
}
