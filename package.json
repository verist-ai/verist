{
  "name": "verist",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/bun": "^1.3.8",
    "gh-pages": "^6.3.0",
    "prettier": "^3.8.1",
    "srcpack": "^0.1.15",
    "typescript": "^5.9.3",
    "vitepress": "^2.0.0-alpha.15",
    "vue": "^3.5.27"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "prepublish": "bun run build && bun run scripts/prepublish.ts",
    "release": "bun run prepublish && changeset publish && git checkout packages/*/package.json",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "docs:deploy": "gh-pages -d .vitepress/dist -b main -o docs"
  }
}
